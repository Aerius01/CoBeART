"""Tiny deterministic model following the grass module interface, for exporter tests.

Leaf(id, tiller, rank, birth_time, age, state, o): a leaf born in the step starting at time b first appears
with age DT and birth_time b. From age LIFE - 1 its senescence rises linearly over its senescence_duration (1 or
1.5 P, drawn from its own stream), as in grass.lpy: by DT / senescence_duration per step, positive from the first
senescent step. At senescence 1 it is dead and keeps its size while its fade rises to 1 over FADE_DURATION, then
collapses (zero sizes, attach at the tiller base). PREVIEW_DECLINE is unused (parity with grass.lpy); the
decline externs carry grass.lpy's defaults so the exporter accepts the model; decline_draw is a unit draw in [-1, 1].
The axiom leaf is born at time 0 with age 0. Apex needs the module declaration below to bind its parameters.
"""
import math
import random

extern(SEED=1)
extern(DT=0.5)
extern(T_END=12.0)
extern(LIFE=4.0)
extern(FADE_DURATION=1.0)
extern(PREVIEW_DECLINE=0.0)
extern(V_DEAD=0.15)
extern(DECLINE_AGE_SPREAD=0.4)
extern(DECLINE_AGE_REF=3.0)
extern(DECLINE_JITTER=0.1)
extern(DECLINE_RESIDUAL=0.5)
extern(SHRIVEL_FRACTION=0.3)
extern(ANGLE_SENESCENT_DEG=12.0)
extern(SHRIVEL_ANGLE_DEG=25.0)
extern(SHRIVEL_ARCH_RAD=0.8)
extern(DECLINE_SPLAY_DEG=25.0)

rng = random.Random(SEED)
jitter = {}
draws = {}


def decline_draw(leaf_id):
    if leaf_id not in draws:
        draws[leaf_id] = rng.uniform(-1.0, 1.0)
    return draws[leaf_id]


def birth_jitter(leaf_id):
    if leaf_id not in jitter:
        jitter[leaf_id] = rng.uniform(-0.2, 0.2)
    return jitter[leaf_id]


def senescence_duration(leaf_id):
    return random.Random("senescence:%d:%s" % (SEED, leaf_id)).choice((1.0, 1.5))


def senescence(leaf_id, age):
    return min(1.0, max(0.0, (age - (LIFE - 1.0)) / senescence_duration(leaf_id)))


def leaf_state(leaf_id, age):
    sen = senescence(leaf_id, age)
    if sen >= 1.0:
        return "dead"
    if sen > 0.0:
        return "senescent"
    return "growing" if age < 1.0 else "mature"


def leaf_o(leaf_id, tiller, rank, age):
    j = birth_jitter(leaf_id)
    az = math.pi * (rank % 2) + j
    sen = senescence(leaf_id, age)
    death_age = LIFE - 1.0 + senescence_duration(leaf_id)
    fade = min(1.0, max(0.0, (age - death_age) / FADE_DURATION))
    size = 0.0 if fade >= 1.0 else min(1.0, age / 2.0)
    sheath = 0.05 * size
    return {
        "attach": [0.004 * tiller, 0.0, sheath],
        "direction": [math.sin(0.3) * math.cos(az), math.sin(0.3) * math.sin(az), math.cos(0.3)],
        "azimuth_rad": az,
        "angle_from_axis_rad": 0.3 + 0.1 * age,
        "sheath_length_m": sheath,
        "blade_length_m": 0.15 * size,
        "blade_width_m": 0.01 * size,
        "unroll": min(1.0, age / 2.0),
        "arch_rad": 0.4,
        "senescence": sen,
        "fade": fade,
        "decline_draw": decline_draw(leaf_id),
        "senescence_duration": senescence_duration(leaf_id),
    }


def tiller_o(tiller):
    return {
        "base": [0.004 * tiller, 0.0, 0.0],
        "direction": [0.0, 0.0, 1.0],
        "azimuth_rad": 0.5 * tiller,
        "splay_rad": 0.2 if tiller else 0.0,
    }


def leaf_id_of(tiller, rank):
    return "L%d.%d" % (tiller, rank)


module Apex, Leaf, Tiller

derivation length: int(round(T_END / DT))

Axiom: Tiller(0, 0, 0.0, tiller_o(0)) Leaf("L0.1", 0, 1, 0.0, 0.0, leaf_state("L0.1", 0.0), leaf_o("L0.1", 0, 1, 0.0)) Apex(0, 2, 1.0)

production:

Apex(t, r, tn) :
    tn2 = tn - DT
    if tn2 > 1e-9:
        produce Apex(t, r, tn2)
    else:
        nproduce Leaf(leaf_id_of(t, r), t, r, (r - 1) * 1.0 + 2.0 * t - DT, DT, leaf_state(leaf_id_of(t, r), DT), leaf_o(leaf_id_of(t, r), t, r, DT))
        nproduce Apex(t, r + 1, 1.0)
        if t == 0 and r == 2:
            nproduce Tiller(1, r, (r - 1) * 1.0 - DT, tiller_o(1)) Apex(1, 1, 1.0)

Leaf(i, t, r, b, a, s, o) :
    a2 = a + DT
    produce Leaf(i, t, r, b, a2, leaf_state(i, a2), leaf_o(i, t, r, a2))

endlsystem
