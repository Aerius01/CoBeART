{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobeart.local/schema/cobeart-config.json",
  "title": "CoBeART shared configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["network", "tracking", "arena", "metrics", "hub", "window", "frontend", "debug", "audio"],
  "$defs": {
    "ipv4": {"type": "string", "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "positiveHz": {"type": "number", "exclusiveMinimum": 0},
    "range": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false
    }
  },
  "properties": {
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["client_address", "server_address", "use_multicast", "socketio"],
      "properties": {
        "client_address": {"$ref": "#/$defs/ipv4", "description": "IPv4 address of the CoBe computer."},
        "server_address": {"$ref": "#/$defs/ipv4", "description": "IPv4 address of the OptiTrack (Motive) computer."},
        "use_multicast": {"type": "boolean", "description": "Multicast (true) or unicast (false) NatNet streaming."},
        "socketio": {
          "type": "object", "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": {"type": "string", "minLength": 1, "description": "Hub bind address and client target host."},
            "port": {"$ref": "#/$defs/port", "description": "Hub TCP port."}
          }
        }
      }
    },
    "tracking": {
      "type": "object", "additionalProperties": false,
      "required": ["use_optitrack_client", "tracking_framerate", "package_framerate", "max_num_objects", "x_rescale", "y_rescale"],
      "properties": {
        "use_optitrack_client": {"type": "boolean", "description": "Use the OptiTrack client to compute agent coordinates."},
        "tracking_framerate": {"$ref": "#/$defs/positiveHz", "description": "Hz, rate at which data is received from OptiTrack."},
        "package_framerate": {"$ref": "#/$defs/positiveHz", "description": "Hz, rate at which frames are sent to the hub."},
        "max_num_objects": {"type": "integer", "minimum": 1, "description": "Maximum number of tracked rigid bodies; ids at or above are dropped."},
        "x_rescale": {"type": "number", "exclusiveMinimum": 0, "description": "Arena length along x in meters, used to rescale coordinates."},
        "y_rescale": {"type": "number", "exclusiveMinimum": 0, "description": "Arena length along y in meters, used to rescale coordinates."}
      }
    },
    "arena": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "z"],
      "description": "Arena bounds in millimeters as [min, max].",
      "properties": {
        "x": {"$ref": "#/$defs/range", "description": "mm, [min, max]."},
        "y": {"$ref": "#/$defs/range", "description": "mm, [min, max]."},
        "z": {"$ref": "#/$defs/range", "description": "mm, [min, max]."}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["max_vel", "history_window"],
      "properties": {
        "max_vel": {"type": "number", "exclusiveMinimum": 0, "description": "mm/s, absolute velocity that maps to normVel = 1."},
        "history_window": {"type": "integer", "minimum": 1, "description": "Number of samples in the normalized-velocity smoothing window."}
      }
    },
    "hub": {
      "type": "object", "additionalProperties": false,
      "required": ["audio_max_age_ms"],
      "properties": {
        "audio_max_age_ms": {"type": "integer", "minimum": 0, "description": "Milliseconds after which the latest audio metrics are considered stale."}
      }
    },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "description": "Electron window width in pixels."},
        "height": {"type": "integer", "minimum": 1, "description": "Electron window height in pixels."}
      }
    },
    "frontend": {
      "type": "object", "additionalProperties": false,
      "required": ["bridge_framerate", "splat_color", "composite"],
      "properties": {
        "bridge_framerate": {"$ref": "#/$defs/positiveHz", "description": "Hz, bridge-to-simulation forwarding loop rate."},
        "splat_color": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "number", "minimum": 0, "maximum": 1},
          "description": "Default splat color as RGB, each channel 0 to 1."
        },
        "composite": {
          "type": "object", "additionalProperties": false,
          "required": ["z_threshold", "clap_distance", "show_interactive_elements"],
          "properties": {
            "z_threshold": {"type": "number", "description": "mm, hand height that triggers a simulation switch."},
            "clap_distance": {"type": "number", "minimum": 0, "description": "mm, hand separation counted as a clap."},
            "show_interactive_elements": {"type": "boolean", "description": "Show interactive UI elements in the composite view."}
          }
        }
      }
    },
    "debug": {"type": "boolean", "description": "Enable debug output across layers."},
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["chunk_size", "sample_rate", "beat_detection"],
      "properties": {
        "chunk_size": {"type": "integer", "minimum": 1, "description": "Samples per analysis chunk."},
        "sample_rate": {"type": "integer", "minimum": 1, "description": "Hz, used when the device default is unavailable."},
        "beat_detection": {"type": "boolean", "description": "Enable beat detection (default on per D4)."}
      }
    }
  }
}
